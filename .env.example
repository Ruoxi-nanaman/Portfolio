# Environment variables for the Ruo Xi portfolio.
# Copy to `.env` and fill in real values. Never commit `.env`.
# These are consumed only by the Vercel Serverless Function (api/contact.js).

# Resend API key used to deliver contact form emails (server-side only).
RESEND_API_KEY=

# Verified Resend sender address used as the email "from" field.
CONTACT_FROM_EMAIL=

# Portfolio owner's address that receives contact form submissions.
CONTACT_TO_EMAIL=
